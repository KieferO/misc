def check(mpass):
    pass2 = getpass.getpass('Enter password again to confirm: ').encode('utf-8')
    if pass2 != mpass:
        raise ValueError('Passwords do not match.')
    return pass2

class Account:
    def __init__(self, name, url, user, output, sequence):
        self.name = name
        self.url = url.encode('utf-8')
        self.user = user
        self.output = output
        self.sequence = sequence

    def get_pass(self, mpass):
        flavours = {}
        flavours['Base85'] = ascii85
        flavours['Base64'] = ascii64
        flavours['RAW'] = hexify
        flavours['Base10'] = ascii10
        flavours['EasyType'] = easyType
        flavours['XKCDPass'] = phrase
        outpass = self.output
        for flavour in flavours:
            if flavour in outpass:
                password = get_hashpass(
                    mpass, self.url, flavours[flavour], self.sequence
                )
                outpass = outpass.replace(flavour, password)
        return outpass

    def __repr__(self):
        return 'Account(name=%s, url=%s, user=%s, output=%s, sequence=%d)' % \
                (self.name, self.url, self.user, self.output, self.sequence)

    def __str__(self):
        fmt_parts = ['%(name)s']
        fmt_parts.append('\tUrl: %s' % self.url.decode('utf-8'))
        if '@' in self.user: 
            fmt_parts.append('\tEmail: %(user)s')
        else:
            fmt_parts.append('\tUsername: %(user)s')
        fmt_parts.append('\tOutput: %(output)s')
        if self.sequence:
            fmt_parts.append('\tSequence: %(sequence)s')
        return '\n'.join(fmt_parts) % self.__dict__

    def dump(self, mpass):
        return str(self) + '\n\tPassword: ' + self.get_pass(mpass)

def whirlpoolhex(indata):
    #m = hashlib.new('whirlpool')
    m = whirlpool.new()
    m.update(indata)
    return m.hexdigest()

class AccountsStore:
    def __init__(self, fn):
        self.configfn = fn
        with open(self.configfn) as f:
            self.mpasshash = f.readline().strip()
            self.accounts = []
            name, user, url, output = ('',) * 4
            sequence = 0
            for line in f:
                line = line.strip()
                if not line:
                    new_a = Account(name, url, user, output, sequence)
                    self.accounts.append(new_a)
                    name, user, url, output = ('',) * 4
                    sequence = 0
                if not ':' in line:
                    name = line
                else:
                    before, delim, after = line.partition(':')
                    after = after.strip()
                    if before in ('User', 'Username', 'Email'):
                        user = after
                    if before == 'URL':
                        url = after
                    if before == 'Output':
                        output = after
                    if before == 'Sequence':
                        sequence = int(after)
        self.name_acc = {}
        for account in self.accounts:
            self.name_acc[account.name] = account

    def complete(self, text, state):
        all_accs = []
        if not text: all_accs.append('ls')
        for name in self.name_acc:
            if name.startswith(text): all_accs.append(name)
        if state > len(all_accs):
            return None
        else:
            return all_accs[state]

    def __str__(self):
        return '\n\n'.join([ str(a) for a in self.accounts ])

    def dump(self, mpass):
        return '\n\n'.join([ a.dump(mpass) for a in self.accounts ])

def get_args():
    ap = argparse.ArgumentParser()
    ap.add_argument(
        '--ignore-preset',
        help='Accept whatever is entered as the master password without '
        'prompting for confirmation nor checking against the hash stored '
        'in the accounts file.',
        action='store_false',
        dest='check_mpass'
    )
    ap.add_argument(
        '--one-shot',
        help='If not present as arguments, prompt for --url and --output, '
        'yield one password, and exit.',
        action='store_true'
    )
    ap.add_argument(
        '--url',
        help='The URL of the site which requests a password.  Implies '
        '--one-shot.  The URL should include any subdomains, but not the '
        'protocol, i.e. www.google.com, not https://www.google.com/ or '
        'google.com'
    )
    ap.add_argument(
        '--output',
        metavar='FLAVOUR',
        help='Specify the output flavour of the password.  Usually just Base85 '
        '(which contains special characters) or Base64 (which contains only '
        'alphanumerics), but can include other characters to satisfy password '
        'complexity requirements.  Implies --one-shot.',
    )
    ap.add_argument(
        '--save',
        help='Implies --one-shot.  Additionally prompts for --username and '
        '--name if not '
        'present, and saves the resulting account specification to the '
        'accounts file.',
        action='store_true'
    )
    ap.add_argument(
        '--accounts-file',
        metavar='FILE',
        help='Use FILE as the accounts file rather than $HOME/.accounts.',
        dest='configfn',
        default=os.path.join(os.path.expanduser('~'), '.accounts')
    )
    ap.add_argument(
        '--username',
        help='Specify the username for the account.  This does not affect the '
        'generated password.  Implies --one-shot and --save.'
    )
    ap.add_argument(
        '--name',
        help='Specify a descriptive name for the account.  This will be '
        'written to the accounts file and used for later lookups. implies '
        '--one-shot and --save.',
    )
    ap.add_argument(
        '--dump',
        help='Write out the name, url, username, and password of every account '
        'in the accounts file and exit.',
        action='store_true'
    )
    ap.add_argument(
        '--list',
        action='store_true',
        help='Do no prompt for a password; write out the name of every '
        'account'
    )
    ap.add_argument(
        '--no-loop',
        action='store_false',
        help='Quit after writing out the first password.'
    )
    ap.add_argument(
        '--lookup',
        help='Look up a single password and print it to stdout.'
    )
    ap.add_argument(
        '--mpass-file',
        type=argparse.FileType('r'),
        help='Read the master password from the given file rather than '
        'prompting for it.  WARNING: Do not use unless you know what you '
        'are doing.  Leaving files with passwords in them arround is '
        'inherently insecure.'
    )
    args = ap.parse_args()
    if args.username or args.name:
        args.save = True
    if args.save or args.output or args.url:
        args.one_shot = True
    if args.list or args.mpass_file:
        args.check_mpass = False
    return args

def get_or_set_mpass(AS, mpass):
    while whirlpoolhex(mpass) != AS.mpasshash:
        print('Warning! Entered password does not match saved password.')
        prompt = 'Would you like to set it?[yes/No]'
        if prompt == 'yes':
            check(mpass)
            print('Old password hash was: %s' % AS.mpasshash)
            with open(AS.configfn, 'r') as old, open(AS.configfn+'.tmp', 'w') as new:
                old.readline()
                new.write('%s\n' % whirlpoolhex(mpass))
                for line in old:
                    new.write(line)
            os.rename(AS.configfn+'.tmp', AS.configfn)
        else:
            mpass = getpass.getpass('Enter master passowrd: ').encode('utf-8')
    return mpass

def lookup_loop(AS, mpass, forever=True):
    while True:
        try:
            command = input('> ')
        except EOFError:
            sys.stdout.write('\n')
            return 0
        except KeyboardInterrupt:
            sys.stdout.write('^C\n')
            continue
        command = command.rstrip(' ')
        if command == 'ls':
            print('\n'.join(sorted(AS.name_acc.keys())))
        if command in AS.name_acc:
            account = AS.name_acc[command]
            print('Username: %s' % account.user)
            print('Password: %s' % account.get_pass(mpass))
            if not forever:
                return 0
        if set(command) & set('*[]?'):
            filtered = fnmatch.filter(AS.name_acc.keys(), command)
            if len(filtered) > 1:
                for f in filtered:
                    print(f)
            if len(filtered) == 1:
                account = AS.name_acc[filtered[0]]
                print('Username: %s' % account.user)
                print('Password: %s' % account.get_pass(mpass))
                if not forever:
                    return 0

def main():
    args = get_args()
    AS = AccountsStore(args.configfn)
    readline.set_completer_delims('\t\n')
    readline.set_completer(AS.complete)
    mpass = None
    if args.mpass_file:
        mpass = args.mpass_file.read()
        if mpass and mpass[-1] == '\n':
            mpass = mpass[:-1]
        mpass = mpass.encode('utf-8')
    if args.list:
        for account in AS.accounts:
            print(account.name)
        return 0
    if mpass is None:
        try:
            mpass = getpass.getpass('Enter master passowrd: ').encode('utf-8')
        except (EOFError, KeyboardInterrupt):
            sys.stdout.write('\nOperation cancelled. Exiting.\n')
            return 1
    if args.check_mpass:
        mpass = get_or_set_mpass(AS, mpass)
    if args.dump:
        print(AS.dump(mpass))
        return 0
    if args.lookup:
        if args.lookup not in AS.name_acc:
            print('Account `%s\' not found in accounts file.' % args.lookup,
                  file=sys.stderr)
            return 1
        print(AS.name_acc[args.lookup].get_pass(mpass))
        return 0
    if args.one_shot:
        if not args.url:
            args.url          = input('URL     : ')
        if not args.output: 
            args.output       = input('Output  : ')
        if args.save:
            if not args.name:
                args.name     = input('Name    : ')
            if not args.username:
                args.username = input('Username: ')
            with open(args.configfn, 'a') as accountf:
                accountf.write('%s\n' % args.name)
                accountf.write('\tURL: %s\n' % args.url)
                if '@' in args.username and '.' in args.username:
                    accountf.write('\tEmail: %s\n' % args.username)
                else:
                    accountf.write('\tUsername: %s\n' % args.username)
                accountf.write('\tOutput: %s\n' % args.output)
                accountf.write('\n')
        account = Account(args.name, args.url, args.username, args.output, 0)
        print('Username: %s' % account.user)
        print('Password: %s' % account.get_pass(mpass))
    else:
        return lookup_loop(AS, mpass, args.no_loop)

if __name__ == '__main__':
    sys.exit(main())
