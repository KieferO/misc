def inner_ascii85(inbytes):
    val = sum([ v * 256 ** i for v, i in zip(inbytes, range(3, -1, -1)) ])
    charset = string.digits + string.ascii_letters + string.punctuation
    outli = []
    for i in range(5):
        outli.append(charset[val % 85])
        val //= 85
    return ''.join(outli)

def ascii85(inbytes):
    outli = []
    for i in range(0, len(inbytes), 4):
        outli.append(inner_ascii85(inbytes[i:i+4]))
    return ''.join(outli)[:12]

class rhWP():
    def __init__(self):
        self.rhash = subprocess.Popen(
                ['rhash', '-W', '-'], # Args
                stdin=subprocess.PIPE,
                stdout=subprocess.PIPE,
        )

    def update(self, instr):
        self.rhash.stdin.write(instr)

    def hexdigest(self):
        outs, errs = self.rhash.communicate()
        return outs.partition(b' ')[0]

    def digest(self):
        return bytes.fromhex(self.hexdigest().decode('us-ascii'))

def get_hashpass(mpass, url, ofun, sequence):
    #m = hashlib.new('whirlpool')
    m = whirlpool.new()
    m = rhWP()
    for i in range(abs(sequence + 1)):
        #m.update(getpass.getuser().encode('utf-8'))
        m.update(b'khicks')
        m.update(url)
        m.update(mpass)
    passwd = m.digest()
    return ofun(passwd)

def ascii64(inbytes):
    return base64.b64encode(inbytes, b'AB').decode()[:12]

def hexify(inbytes):
    outchars = []
    for by in inbytes:
        hny = by // 16
        lny = by % 16
        outchars.extend([ '0123456789abcdef'[ny] for ny in [hny, lny] ])
    return ''.join(outchars)

def bytes2giantnumber(inbytes):
    n = 0
    for by in reversed(inbytes):
        n <<= 8
        n += int(by)
    return n

def ascii10(inbytes):
    n = bytes2giantnumber(inbytes)
    digits = str(n)
    groups = []
    for i in range(3):
        groups.append(digits[i * 5:(i + 1) * 5])
    return '-'.join(groups)

def easyType(inbytes):
    n = bytes2giantnumber(inbytes)
    outpass = []
    base_chars = '0123456789abcdefghijklmnopqrstuvwxyz'
    syms = ')!@#$%^&*('
    caps = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'
    sym_idx = n % 16
    n //= 16
    cap_idx = n % 15
    n //= 15
    if cap_idx >= sym_idx:
        cap_idx += 1
    for i in range(16):
        if i == sym_idx:
            outpass.append(syms[n % len(syms)])
            n //= len(syms)
        elif i == cap_idx:
            outpass.append(caps[n % len(caps)])
            n //= len(caps)
        else:
            outpass.append(base_chars[n % len(base_chars)])
            n //= len(base_chars)
    return ''.join(outpass)

