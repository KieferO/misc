#!/usr/bin/env python3

import sys
import os
import os.path
import time

def main():
    my_path = '.'
    for dirent in os.scandir(my_path):
        if dirent.is_file():
            mtime = time.localtime(dirent.stat().st_mtime)
            dest_dir = os.path.join(my_path, str(mtime.tm_year))
            if not os.path.isdir(dest_dir):
                os.mkdir(dest_dir)
            os.rename(os.path.join(my_path, dirent.name), os.path.join(dest_dir, dirent.name))
    return 0

if __name__ == '__main__':
    sys.exit(main())
