#!/usr/bin/env python3

import sys
import requests
import argparse
import base64
import requests

def encode_image(image_file):
    return base64.b64encode(image_file.read()).decode("utf-8")

def get_payload(image_file=None, prompt=None):
    base64_image = encode_image(image_file)
    payload = {
        "model": "koboldcpp",
        "messages": [
            {
                "role": "user",
                "content": [
                    {"type": "text", "text": prompt},
                    {
                        "type": "image_url",
                        "image_url": {
                            "url": f"data:image/jpeg;base64,{base64_image}"
                        }
                    }
                ]
            }
        ],
        "max_tokens": -1,
        "temperature": 0.2
    }
    return payload

def get_args():
    parser = argparse.ArgumentParser()
    parser.add_argument(
            '-p', '--prompt',
            help='Prompt to give to the model',
            default='Describe what you see in this image.',
            nargs=1
    )
    parser.add_argument(
            'file',
            metavar='FILE',
            type=argparse.FileType('rb'),
            help='Image file to caption'
    )
    return parser.parse_args()

def main():
    args = get_args()
    payload = get_payload(image_file=args.file, prompt=args.prompt)
    resp = requests.post(
            'http://heqet.hale.hydroxide.us:5001/v1/chat/completions',
            json=payload
    )
    print(resp.json()['choices'][0]['message']['content'])
    return

if __name__ == '__main__':
    sys.exit(main())
